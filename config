theme = light:catppuccin-latte.conf,dark:catppuccin-mocha.conf
shell-integration = fish
font-family = IosevkaRootiestV2 Nerd Font
font-style = Medium
font-family-bold = IosevkaRootiestV2 Nerd Font
font-style-bold = Heavy
font-family-italic = VictorMono Nerd Font
font-style-italic = Italic
font-family-bold-italic = VictorMono Nerd Font
font-style-bold-italic = Bold Italic
font-size = 13
gtk-titlebar = false
window-theme = ghostty
window-colorspace = display-p3
window-title-font-family = Iosevka Rootiest v2

background-opacity = 0.6
window-decoration = auto
gtk-titlebar-style = native

window-height = 36
window-width = 160

keybind = unconsumed:ctrl+k=goto_split:top
keybind = unconsumed:ctrl+j=goto_split:bottom
keybind = unconsumed:ctrl+h=goto_split:left
keybind = unconsumed:ctrl+l=goto_split:right 
